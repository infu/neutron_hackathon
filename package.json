{
  "name": "hackathon-neutron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.11.1",
    "npm": "11.6.2"
  },
  "scripts": {
    "deps": "mops install --no-toolchain --lock check && node scripts/sync-ash-config.mjs",
    "toolchain": "node scripts/check-toolchain.mjs",
    "typecheck": "node scripts/build-backend.mjs --check",
    "test": "ash test test/hackathon.ash.json",
    "test:verbose": "ash test test/hackathon.ash.json --verbose",
    "test:baseline": "ash test test/hackathon.ash.json --set",
    "bindings": "node scripts/bindings.mjs --write",
    "bindings:check": "node scripts/bindings.mjs --check",
    "build:backend": "node scripts/build-backend.mjs",
    "verify:public": "npm run deps && npm run toolchain && npm run build:backend && npm run build:web",
    "network": "icp network start -d",
    "network:stop": "icp network stop",
    "network:status": "icp network status",
    "deploy": "npm run bindings:check && icp deploy",
    "deploy:ic": "npm run bindings:check && icp deploy -e ic",
    "env": "node scripts/write-env.mjs",
    "build:web": "npm run bindings:check && npm run rules:verify && npm --prefix frontend run build",
    "upload": "node scripts/upload.mjs",
    "upload:ic": "npm run web -- -e ic",
    "moderator": "node scripts/moderator.mjs",
    "seed": "node scripts/seed.mjs",
    "showcase": "node scripts/showcase.mjs",
    "art": "assetgen batch assetgen.assets.yaml && node scripts/publish-art.mjs",
    "art:publish": "node scripts/publish-art.mjs",
    "dev": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend ci",
    "favicon": "node scripts/make-favicon.mjs",
    "verify:money": "npm run pic:prep && node --test --test-concurrency=1 test/pic/money.test.mjs test/pic/payout-cutoff.test.mjs",
    "verify:rewards": "npm run pic:prep && npm run verify:rewards:built",
    "verify:rewards:built": "node --test --test-concurrency=1 test/pic/rewards-scale.test.mjs test/pic/payout-cutoff.test.mjs",
    "ledgers:local": "node scripts/local-ledgers.mjs",
    "ledgers:allow": "node scripts/ledger-allowlist.mjs",
    "test:logic": "npm run pic:prep && npm run test:logic:built",
    "test:logic:built": "node --test --test-concurrency=1 test/pic/*.test.mjs",
    "web": "node scripts/ship-web.mjs",
    "pic:prep": "npm run build:backend",
    "test:memory": "npm run pic:prep && node --test --test-concurrency=1 --test-timeout=900000 test/pic/slow/*.test.mjs",
    "test:capacity": "npm run pic:prep && node --test --test-concurrency=1 --test-timeout=900000 test/pic/capacity/*.test.mjs",
    "test:all": "npm test && npm run test:logic && npm run test:memory",
    "test:public": "node --test test/scripts/*.test.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "release:check": "npm run verify:public && npm run verify:rewards:built && npm run test:public && npm run audit:release",
    "release:full": "node scripts/release-attestation.mjs checks",
    "release:attest": "node scripts/release-attestation.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "rules:verify": "node scripts/verify-rules.mjs"
  },
  "dependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/candid": "^3.4.3",
    "@dfinity/identity": "^3.4.3",
    "@dfinity/principal": "^3.4.3"
  },
  "devDependencies": {
    "@dfinity/pic": "0.16.1",
    "@icp-sdk/icp-cli": "1.0.2",
    "ic-mops": "1.12.0",
    "icblast": "4.3.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "hono": "4.12.34"
  }
}
